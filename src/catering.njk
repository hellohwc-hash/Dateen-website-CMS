<section class="sec">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="idx">01</span>
      <span class="label">How it works</span>
      <span class="meta">Buffet &amp; drop-off</span>
    </div>
    <div class="sec-body hiw">
      <div class="hiw-col rv">
        <h3>Served Buffet</h3>
        <p>Full-service buffet with stainless-steel chafing dishes, one service helper and a complete buffet-line set-up. From a minimum of 35 pax, orders below 35 pax carry a 20% surcharge.</p>
        <img src="photos/buffet-served.jpg" alt="Served buffet with chafing dishes" loading="lazy">
      </div>
      <div class="hiw-col rv rv-d1">
        <h3>Drop-Off Catering</h3>
        <p>Delivery only, no buffet-line set-up or service helper, no minimum order. The same menus, packed and delivered on schedule for offices and events.</p>
        <img src="photos/dropoff-catering.jpg" alt="Drop-off catering packed and delivered" loading="lazy">
      </div>
    </div>
  </div>
</section>

<section class="sec menu-band" id="packages">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="idx">02</span>
      <span class="label">Catering Packages</span>
      <span class="meta">Per pax · buffet or drop-off</span>
    </div>
    <h2 class="display-lg sec-title rv">Priced <span class="em" style="color:var(--red);">per pax.</span></h2>
    <div class="sec-body">
<!-- catering packages -->
      <div class="pkg rv">
        <div class="pkg-head">
          <h3>Catering packages, <span class="em" style="color:var(--red);">per pax.</span></h3>
          <p>Served buffet includes one helper and a full buffet-line setup, from a minimum of 35 pax (orders below 35 pax carry a 20% surcharge). Drop-off is delivery-only, with no minimum order.</p>
        </div>

        <div class="pkg-group">
          <span class="gl">Full Day, Breakfast, Lunch &amp; Tea Break</span>
          <div class="pkg-table">
            <div class="pkg-row">
              <div class="pkg-name"><b>Package A</b><span>Nasi minyak, signature rendang chicken, kuih, cake &amp; beverage service.</span></div>
              <div class="pkg-price"><em>from</em><b>RM{{ prices.cateringFullDayA }}</b> <i>/pax</i></div>
            </div>
            <div class="pkg-row">
              <div class="pkg-name"><b>Package B</b><span>Kampung fried rice, ayam masak merah, cereal fish, four-season roll &amp; more.</span></div>
              <div class="pkg-price"><em>from</em><b>RM{{ prices.cateringFullDayB }}</b> <i>/pax</i></div>
            </div>
            <div class="pkg-row">
              <div class="pkg-name"><b>Package C, Western</b><span>Aglio olio, black pepper chicken chop, marmite fish, fruit tarts &amp; coffee.</span></div>
              <div class="pkg-price"><em>from</em><b>RM{{ prices.cateringFullDayC }}</b> <i>/pax</i></div>
            </div>
          </div>
        </div>

        <div class="pkg-group">
          <span class="gl">Lunch &amp; Dinner, Buffet or Drop-Off</span>
          <div class="pkg-table">
            <div class="pkg-row">
              <div class="pkg-name"><b>Local Set · Package A–D</b><span>Rice, signature chicken, fish, noodle, vegetable, fruit &amp; cordial. Four tiers.</span></div>
              <div class="pkg-price"><em>from</em><b>RM{{ prices.cateringLunchLocal }}</b> <i>/pax</i></div>
            </div>
            <div class="pkg-row">
              <div class="pkg-name"><b>Western Set · Package A–C</b><span>Pasta, black pepper chicken chop, fish fillet, garden salad &amp; dessert.</span></div>
              <div class="pkg-price"><em>from</em><b>RM{{ prices.cateringLunchWestern }}</b> <i>/pax</i></div>
            </div>
          </div>
        </div>

        <div class="pkg-group">
          <span class="gl">Tea Break, Buffet or Drop-Off</span>
          <div class="pkg-table">
            <div class="pkg-row">
              <div class="pkg-name"><b>Local Break · A &amp; B</b><span>Mee hoon, kuih, sandwiches, swiss roll, coffee &amp; teh tarik.</span></div>
              <div class="pkg-price"><em>from</em><b>RM{{ prices.cateringTeaLocal }}</b> <i>/pax</i></div>
            </div>
            <div class="pkg-row">
              <div class="pkg-name"><b>Western Break · A &amp; B</b><span>Assorted buns, sandwiches, mini tarts, muffins, fresh fruit &amp; americano.</span></div>
              <div class="pkg-price"><em>from</em><b>RM{{ prices.cateringTeaWestern }}</b> <i>/pax</i></div>
            </div>
          </div>
        </div>
      </div>

      
      <div class="menu-foot rv">
        <p>All prices in Malaysian Ringgit (RM), not subject to SST. Served buffet from 35 pax; drop-off has no minimum.</p>
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
