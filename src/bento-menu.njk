      <div class="mgroup" data-cat="coldbrew">
        <div class="cb-feature">
          <div class="cb-visual rv"><img src="{{ site.banners.coldbrew }}" alt="Dateen Cold Brew, Specialty Coffee and Caffe Latte, for corporate events" loading="lazy"></div>
