<!-- ============ 03 MENU ============ -->
<section class="sec menu-band" id="menu">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="idx">03</span>
      <span class="label">The Menu</span>
      <span class="meta">À la carte sets · catering packages</span>
    </div>
    <h2 class="display-lg sec-title rv">From the <span class="em" style="color:var(--red);">kitchen.</span></h2>
    <div class="sec-body">
      <p class="menu-lead rv">Choose from over 40 halal dishes across five daily-set lines, plus full-day, lunch, dinner and tea-break catering packages priced per pax. A selection of house favourites is featured below, while the full menu is available via <a href="https://wa.me/{{ site.whatsapp }}?text=Hi%20Dateen%21%20I%27m%20interested%20in%20your%20Bento%20Menu." style="color:var(--red);font-weight:600;border-bottom:1px solid var(--red);">WhatsApp</a>.</p>
      <div class="menu-filters rv">
        <span class="mtab on" data-cat="all">All</span>
        <span class="mtab" data-cat="bento">Bento Rice &amp; Noodle</span>
        <span class="mtab" data-cat="nasilemak">Nasi Lemak</span>
        <span class="mtab" data-cat="value">Value Meal</span>
        <span class="mtab" data-cat="veggie">Veggie</span>
        <span class="mtab" data-cat="side">Side Dish</span>
        <span class="mtab" data-cat="drinks">Drinks</span>
        <span class="mtab" data-cat="coldbrew">Cold Brew</span>
      </div>
      <!-- A. BENTO RICE & NOODLE -->
      <div class="mgroup" data-cat="bento">
        <div class="mgroup-head">
          <h3>Bento Rice &amp; Noodle</h3>
          <span class="sub">Served with vege of the day &amp; fried egg, or soup, chicken dumpling &amp; vege</span>
          <span class="price-note">From RM{{ prices.bentoFrom }}</span>
        </div>
        <div class="menu-grid rv">
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/rendang-chicken.jpg');"><span class="mcard-tag red">Best Seller</span></div>
            <div class="mcard-inner">
              <h4>Rendang Chicken Bento</h4>
              <p>Four-hour slow-braised rendang, the recipe that built the house.</p>
              <div class="mcard-price">RM 17.90 <span class="u">per box</span></div>
            </div>
          </div>
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/nasi-lemak-rendang.jpg');"><span class="mcard-tag red">Best Seller</span></div>
            <div class="mcard-inner">
              <h4>Nasi Lemak Rendang Chicken</h4>
              <p>Coconut rice, sambal, egg &amp; our signature rendang.</p>
              <div class="mcard-price">RM 18.90 <span class="u">per box</span></div>
            </div>
          </div>
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/ayam-masak-merah.jpg');"><span class="mcard-tag red">Best Seller</span></div>
            <div class="mcard-inner">
              <h4>Ayam Masak Merah Bento</h4>
              <p>Chicken in a sweet-spiced tomato sambal.</p>
              <div class="mcard-price">RM 17.90 <span class="u">per box</span></div>
            </div>
          </div>
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/char-keow-teow.jpg');"><span class="mcard-tag red">Best Seller</span></div>
            <div class="mcard-inner">
              <h4>Penang Fried Keow Teow</h4>
              <p>Wok-fried flat noodle with prawn and egg.</p>
              <div class="mcard-price">RM 17.90 <span class="u">per box</span></div>
            </div>
          </div>
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/sweet-sour-fish.jpg');"><span class="mcard-tag red">Best Seller</span></div>
            <div class="mcard-inner">
              <h4>Sweet &amp; Sour Fish Fillet</h4>
              <p>Boneless fillet in a tangy tomato glaze.</p>
              <div class="mcard-price">RM 17.90 <span class="u">per box</span></div>
            </div>
          </div>
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/cereal-fish.jpg');"></div>
            <div class="mcard-inner">
              <h4>Crispy Cereal Fish Fillet</h4>
              <p>Nestum cereal crust with butter and curry leaf.</p>
              <div class="mcard-price">RM 17.90 <span class="u">per box</span></div>
            </div>
          </div>
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/curry-noodle.jpg');"><span class="mcard-tag red">Signature</span></div>
            <div class="mcard-inner">
              <h4>Dry Curry Chicken Noodle</h4>
              <p>House dry-curry noodle with tender chicken.</p>
              <div class="mcard-price">RM 17.90 <span class="u">per box</span></div>
            </div>
          </div>
          <div class="mcard">
            <div class="mcard-img" style="background-image:url('photos/veg-fried-rice.jpg');"><span class="mcard-tag green">Vegetarian</span></div>
            <div class="mcard-inner">
              <h4>Vegetarian Fried Rice</h4>
              <p>Wok-fried rice with mixed vegetables and soy.</p>
              <div class="mcard-price">RM 17.90 <span class="u">per box</span></div>
            </div>
          </div>
