    <div class="sec-body">
      <div class="proc-grid rv">
        <div class="proc-step">
          <span class="t">WhatsApp</span>
          <span class="ghost">01</span>
          <h4>Brief</h4>
          <p>Send your date, pax count and dietary requirements. We respond within two business hours.</p>
        </div>
        <div class="proc-step">
          <span class="t">24 hrs</span>
          <span class="ghost">02</span>
          <h4>Quote &amp; Menu</h4>
          <p>A tailored quotation with menu options matched to your budget and headcount.</p>
        </div>
        <div class="proc-step">
          <span class="t">3 days ahead</span>
          <span class="ghost">03</span>
          <h4>Confirm</h4>
          <p>Lock the order. We handle preparation, packaging, logistics and compliance paperwork.</p>
        </div>
        <div class="proc-step">
          <span class="t">On the day</span>
          <span class="ghost">04</span>
          <h4>Deliver &amp; Serve</h4>
          <p>On-time arrival, full buffet setup with servers, and cleanup after the event.</p>
        </div>
      </div>
    </div>
  </div>
</section>

