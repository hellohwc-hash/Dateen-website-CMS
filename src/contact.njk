<!-- ============ 12 CONTACT ============ -->
<section class="sec contact" id="contact">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="idx"><!--E:contact.6|Contact|Section number-->12<!--/E--></span>
      <span class="label"><!--E:contact.7|Contact|Small label-->Contact<!--/E--></span>
      <span class="meta"><!--E:contact.8|Contact|Small caption-->We respond within two business hours<!--/E--></span>
    </div>
    <div class="sec-body">
      <div>
        <h2 class="display-md rv" style="margin-bottom:36px;"><!--E:contact.9|Contact|Text in Title-->Speak with<!--/E--> <span class="em" style="color:var(--red);"><!--E:contact.10|Contact|Accent text-->our team.<!--/E--></span></h2>
        <div class="con-list rv">
          <div class="con-row">
            <span class="label"><!--E:contact.11|Contact|Small label-->WhatsApp<!--/E--></span>
            <div><a href="https://wa.me/{{ site.whatsapp }}?text=Hi%20Dateen%21%20I%27d%20like%20to%20make%20an%20enquiry.">{{ site.phoneIntl }}</a><small><!--E:contact.12|Contact|Text-->Fastest channel for quotes and event briefs<!--/E--></small></div>
          </div>
          <div class="con-row">
            <span class="label"><!--E:contact.13|Contact|Small label-->Email<!--/E--></span>
            <div><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
          </div>
          <div class="con-row">
            <span class="label"><!--E:contact.14|Contact|Small label-->Address<!--/E--></span>
            <div><span class="v"><!--E:contact.15|Contact|Text (v)-->18, Jalan Perdana 6/8b, Pandan Perdana, 55300 Cheras, KL<!--/E--></span></div>
          </div>
          <div class="con-row">
            <span class="label"><!--E:contact.16|Contact|Small label-->Hours<!--/E--></span>
            <div><span class="v"><!--E:contact.17|Contact|Text (v)-->Mon – Fri · 8:00am – 6:00pm<!--/E--></span><small><!--E:contact.18|Contact|Text-->Sat · 9:00am – 2:00pm<!--/E--></small></div>
          </div>
          <div class="con-row">
            <span class="label"><!--E:contact.19|Contact|Small label-->Social<!--/E--></span>
            <div><a href="https://instagram.com/dateencatering"><!--E:contact.20|Contact|Link / button-->@dateencatering<!--/E--></a><small><!--E:contact.21|Contact|Text-->Instagram · Facebook<!--/E--></small></div>
          </div>
        </div>
      </div>
      <form class="form rv rv-d1" id="quoteForm">
        <h3><!--E:contact.22|Contact|Sub-title-->Request a quote<!--/E--></h3>
        <p><!--E:contact.23|Contact|Paragraph-->Tell us about your event, we'll reply with a tailored menu and quotation.<!--/E--></p>
        <div class="f-row">
          <div class="f-field"><label for="qf-name"><!--E:contact.24|Contact|Form label-->Name<!--/E--></label><input id="qf-name" name="name" type="text" placeholder="Your name" required></div>
          <div class="f-field"><label for="qf-company"><!--E:contact.25|Contact|Form label-->Company<!--/E--></label><input id="qf-company" name="company" type="text" placeholder="Company name"></div>
        </div>
        <div class="f-row">
          <div class="f-field"><label for="qf-email"><!--E:contact.13|Contact|Form label-->Email<!--/E--></label><input id="qf-email" name="email" type="email" placeholder="you@company.com"></div>
          <div class="f-field"><label for="qf-phone"><!--E:contact.26|Contact|Form label-->Phone<!--/E--></label><input id="qf-phone" name="phone" type="tel" placeholder="012-345 6789"></div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <label for="qf-service"><!--E:contact.27|Contact|Form label-->Service<!--/E--></label>
            <select id="qf-service" name="service">
              <option>Catering Buffet</option>
              <option>Corporate Bento</option>
              <option>Daily Bungkus Supply</option>
              <option>Vegetarian Catering</option>
              <option>Cold Brew Coffee</option>
              <option>Festive Special</option>
            </select>
          </div>
          <div class="f-field"><label for="qf-pax"><!--E:contact.28|Contact|Form label-->Pax / Quantity<!--/E--></label><input id="qf-pax" name="pax" type="text" placeholder="e.g. 50 pax"></div>
        </div>
        <div class="f-field"><label for="qf-date"><!--E:contact.29|Contact|Form label-->Event date<!--/E--></label><input id="qf-date" name="date" type="date"></div>
        <div class="f-field"><label for="qf-brief"><!--E:contact.30|Contact|Form label-->Brief<!--/E--></label><textarea id="qf-brief" name="brief" placeholder="Dietary preferences, budget range, venue details..."></textarea></div>
        <button type="submit" class="btn btn-red">Send Inquiry
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
        <p class="form-note" id="qf-note" hidden><!--E:contact.31|Contact|Paragraph-->Opening WhatsApp with your inquiry, please tap send to complete.<!--/E--></p>
      </form>
    </div>
  </div>
</section>

