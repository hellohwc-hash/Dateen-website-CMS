<!-- ============ 12 CONTACT ============ -->
<section class="sec contact" id="contact">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="idx">12</span>
      <span class="label">Contact</span>
      <span class="meta">We respond within two business hours</span>
    </div>
    <div class="sec-body">
      <div>
        <h2 class="display-md rv" style="margin-bottom:36px;">Speak with <span class="em" style="color:var(--red);">our team.</span></h2>
        <div class="con-list rv">
          <div class="con-row">
            <span class="label">WhatsApp</span>
            <div><a href="https://wa.me/{{ site.whatsapp }}?text=Hi%20Dateen%21%20I%27d%20like%20to%20make%20an%20enquiry.">{{ site.phoneIntl }}</a><small>Fastest channel for quotes and event briefs</small></div>
          </div>
          <div class="con-row">
            <span class="label">Email</span>
            <div><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
          </div>
          <div class="con-row">
            <span class="label">Address</span>
            <div><span class="v">18, Jalan Perdana 6/8b, Pandan Perdana, 55300 Cheras, KL</span></div>
          </div>
          <div class="con-row">
            <span class="label">Hours</span>
            <div><span class="v">Mon – Fri · 8:00am – 6:00pm</span><small>Sat · 9:00am – 2:00pm</small></div>
          </div>
          <div class="con-row">
            <span class="label">Social</span>
            <div><a href="https://instagram.com/dateencatering">@dateencatering</a><small>Instagram · Facebook</small></div>
          </div>
        </div>
      </div>
      <form class="form rv rv-d1" id="quoteForm">
        <h3>Request a quote</h3>
        <p>Tell us about your event, we'll reply with a tailored menu and quotation.</p>
        <div class="f-row">
          <div class="f-field"><label for="qf-name">Name</label><input id="qf-name" name="name" type="text" placeholder="Your name" required></div>
          <div class="f-field"><label for="qf-company">Company</label><input id="qf-company" name="company" type="text" placeholder="Company name"></div>
        </div>
        <div class="f-row">
          <div class="f-field"><label for="qf-email">Email</label><input id="qf-email" name="email" type="email" placeholder="you@company.com"></div>
          <div class="f-field"><label for="qf-phone">Phone</label><input id="qf-phone" name="phone" type="tel" placeholder="012-345 6789"></div>
        </div>
        <div class="f-row">
          <div class="f-field">
            <label for="qf-service">Service</label>
            <select id="qf-service" name="service">
              <option>Catering Buffet</option>
              <option>Corporate Bento</option>
              <option>Daily Bungkus Supply</option>
              <option>Vegetarian Catering</option>
              <option>Cold Brew Coffee</option>
              <option>Festive Special</option>
            </select>
          </div>
          <div class="f-field"><label for="qf-pax">Pax / Quantity</label><input id="qf-pax" name="pax" type="text" placeholder="e.g. 50 pax"></div>
        </div>
        <div class="f-field"><label for="qf-date">Event date</label><input id="qf-date" name="date" type="date"></div>
        <div class="f-field"><label for="qf-brief">Brief</label><textarea id="qf-brief" name="brief" placeholder="Dietary preferences, budget range, venue details..."></textarea></div>
        <button type="submit" class="btn btn-red">Send Inquiry
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
        <p class="form-note" id="qf-note" hidden>Opening WhatsApp with your inquiry, please tap send to complete.</p>
      </form>
    </div>
  </div>
</section>

