<!-- ============ 11 FAQ ============ -->
<section class="sec" id="faq">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="idx"><!--E:contact.43|Frequently Asked|Section number-->11<!--/E--></span>
      <span class="label"><!--E:contact.44|Frequently Asked|Small label-->Frequently Asked<!--/E--></span>
      <span class="meta"><!--E:contact.45|Frequently Asked|Small caption-->Before you place an order<!--/E--></span>
    </div>
    <div class="sec-body">
      <div class="faq-list rv">
        <details class="faq-it" open>
          <summary>
            <span class="n"><!--E:contact.46|Frequently Asked|Point letter-->01<!--/E--></span>
            <h5><!--E:contact.47|Frequently Asked|Text-->What areas do you serve?<!--/E--></h5>
            <span class="tg"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
          </summary>
          <div class="ans"><!--E:contact.48|Frequently Asked|Text (ans)-->We deliver across Kuala Lumpur and Selangor, including Petaling Jaya, Subang, Shah Alam, Cheras, Ampang, KLCC, Bangsar and Mont Kiara. Free delivery applies to orders above RM50 within the Klang Valley.<!--/E--></div>
        </details>
        <details class="faq-it">
          <summary>
            <span class="n"><!--E:contact.49|Frequently Asked|Point letter-->02<!--/E--></span>
            <h5><!--E:contact.50|Frequently Asked|Text-->What types of catering do you offer?<!--/E--></h5>
            <span class="tg"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
          </summary>
          <div class="ans"><!--E:contact.51|Frequently Asked|Text (ans)-->Buffet catering, bento meals, daily bungkus supply, vegetarian lines and cold brew, serving corporate functions, training sessions, festive open houses and private events.<!--/E--></div>
        </details>
        <details class="faq-it">
          <summary>
            <span class="n"><!--E:contact.52|Frequently Asked|Point letter-->03<!--/E--></span>
            <h5><!--E:contact.53|Frequently Asked|Text-->What is the minimum order?<!--/E--></h5>
            <span class="tg"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
          </summary>
          <div class="ans"><!--E:contact.54|Frequently Asked|Text (ans)-->À la carte bento and daily sets start from a single box, with no minimum. Served buffet catering is available from 35 pax, orders below 35 pax carry a 20% surcharge. Drop-off (delivery-only) catering has no minimum order.<!--/E--></div>
        </details>
        <details class="faq-it">
          <summary>
            <span class="n"><!--E:contact.55|Frequently Asked|Point letter-->04<!--/E--></span>
            <h5><!--E:contact.56|Frequently Asked|Text-->Can I customise my menu?<!--/E--></h5>
            <span class="tg"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
          </summary>
          <div class="ans"><!--E:contact.57|Frequently Asked|Text (ans)-->Yes. Menus are mixed and matched to your headcount, budget and dietary requirements, including vegetarian and allergen-conscious options. Share your brief via WhatsApp and we'll propose a tailored menu.<!--/E--></div>
        </details>
        <details class="faq-it">
          <summary>
            <span class="n"><!--E:contact.58|Frequently Asked|Point letter-->05<!--/E--></span>
            <h5><!--E:contact.59|Frequently Asked|Text-->How early should I book?<!--/E--></h5>
            <span class="tg"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
          </summary>
          <div class="ans"><!--E:contact.60|Frequently Asked|Text (ans)-->Daily bungkus and bento orders confirmed before 10:00am qualify for same-day delivery. Buffet and event catering should be confirmed at least 3 working days ahead; festive-season dates book out earlier.<!--/E--></div>
        </details>
      </div>
    </div>
  </div>
